#!/usr/bin/env bach-play 120 48
n 3 maj@60:-10 mp *
n 3 maj@60:0 mf 1/4
n 3 maj@60:2 mf 1/4
n 3 maj@60:4 mf 1/4
+ 1/4
n 3 maj@60:0 p 1/4
n 3 maj@60:3 p 1/4
n 3 maj@60:5 p 1/4
+ 1/1
n 3 maj@60:-10 - -
+ 1/2
n 3 @40 f *
n 3 @80 f 1/192
+ 1/1
. maj@60:0
. maj@60:2
. maj@60:4
s 3 mf 1/8 7 12 0
. maj@60:6
s 3 mf 1/8 6 12 1
+ 12/8
