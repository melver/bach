#!/usr/bin/env bach-play 120 48
j 1
+ 100/1
n 2 maj@60:-10 mp *
n 2 maj@60:0 mf 1/4
n 2 maj@60:2 mf 1/4
n 2 maj@60:4 mf 1/4
+ 1/4
n 2 maj@60:0 p 1/4
n 2 maj@60:3 p 1/4
n 2 maj@60:5 p 1/4
+ 1/1
n 2 maj@60:-10 - -
+ 1/2
n 2 @40 f *
n 2 @80 f 1/192
+ 1/1
s 2 maj@60:0,maj@60:2,maj@60:4 mf 1/8 7 12 0
s 2 maj@60:6 mf 1/8 6 12 1
+ 12/8
