#!/usr/bin/env bach-vm 120 48
.scale maj@60:0
.time_sig 1/4

# start "infinite" note
push 3
push -10
push 53
push -1
qnote

push 3
push 0
push 64
push 1
qnote

push 3
push 2
push 64
push 1
qnote

push 3
push 4
push 64
push 1
qnote

push 0
push 1
send
yield

push 3
push 0
push 42
push 1
qnote

push 3
push 3
push 42
push 1
qnote

push 3
push 5
push 42
push 1
qnote

push 0
push 4
send
yield

# stop the "infinite" note
push 3
push -10
push 0
push 0
qnote

push 0
push 2
send
yield

push 3
push -15
push 80
push -1
qnote

push 3
push 10
push 80
push 1
qnote

push 0
push 4
send
